# Server-only reference data. Defaults: live, testnet.
# live uses the verified public InjectiveLabs / SICI/USDC oracle.
# fixture avoids network access and uses explicitly labelled example data.
GIA_SICI_MODE=live
GIA_SICI_NETWORK=testnet

# Only mock execution is implemented. Selecting injective does NOT enable trading.
# A real Options endpoint/deployment, series registry and quote schema are pending.
GIA_ADAPTER=mock
